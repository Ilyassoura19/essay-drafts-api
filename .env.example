# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real password never reaches GitHub.

# Port the Express server listens on
PORT=3000

# PostgreSQL connection string.
# Supabase: Project Settings -> Database -> Connection string -> "URI"
# (use the Session pooler URI if your network has no IPv6)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# true for Supabase or any cloud database (encrypted connection),
# false for a PostgreSQL running on your own laptop
DATABASE_SSL=true
